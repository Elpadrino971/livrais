// Livrais iOS App Configuration
// This file contains build settings for the Livrais iOS application

// MARK: - Product Configuration

PRODUCT_NAME = Livrais
PRODUCT_BUNDLE_IDENTIFIER = gf.livrais.app
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

// MARK: - Deployment

IPHONEOS_DEPLOYMENT_TARGET = 17.0
TARGETED_DEVICE_FAMILY = 1,2
SUPPORTS_MACCATALYST = NO

// MARK: - Build Settings

SWIFT_VERSION = 5.9
ENABLE_BITCODE = NO
SWIFT_COMPILATION_MODE = wholemodule
SWIFT_OPTIMIZATION_LEVEL = -O
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited)

// MARK: - Code Signing

CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM = YOUR_TEAM_ID
CODE_SIGN_IDENTITY = iPhone Developer

// MARK: - Capabilities

ENABLE_BACKGROUND_FETCH = YES
ENABLE_BACKGROUND_LOCATION = YES
ENABLE_PUSH_NOTIFICATIONS = YES
ENABLE_APP_GROUPS = YES

// MARK: - Environment Variables
// These should be set in Xcode Build Settings or via environment

SUPABASE_URL = $(SUPABASE_URL)
SUPABASE_ANON_KEY = $(SUPABASE_ANON_KEY)
STRIPE_PUBLISHABLE_KEY = $(STRIPE_PUBLISHABLE_KEY)

// MARK: - App Transport Security

SECURITY_REQUIRE_HTTPS = YES
SECURITY_ALLOW_LOCAL_NETWORKING = YES

// MARK: - Performance

COMPILER_INDEX_STORE_ENABLE = YES
CLANG_ENABLE_MODULE_DEBUGGING = YES

// MARK: - Warnings

GCC_WARN_ABOUT_RETURN_TYPE = YES_ERROR
GCC_WARN_UNDECLARED_SELECTOR = YES
GCC_WARN_UNINITIALIZED_AUTOS = YES_AGGRESSIVE
GCC_WARN_UNUSED_FUNCTION = YES
GCC_WARN_UNUSED_VARIABLE = YES
CLANG_WARN_BOOL_CONVERSION = YES
CLANG_WARN_CONSTANT_CONVERSION = YES
CLANG_WARN_DIRECT_OBJC_ISA_USAGE = YES_ERROR
CLANG_WARN_EMPTY_BODY = YES
CLANG_WARN_ENUM_CONVERSION = YES
CLANG_WARN_INFINITE_RECURSION = YES
CLANG_WARN_INT_CONVERSION = YES
CLANG_WARN_OBJC_ROOT_CLASS = YES_ERROR
CLANG_WARN_SUSPICIOUS_MOVE = YES
CLANG_WARN_UNREACHABLE_CODE = YES

// MARK: - Other Linker Flags

OTHER_LDFLAGS = $(inherited) -ObjC

// MARK: - Asset Catalog

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = Primary
ASSETCATALOG_COMPILER_INCLUDE_ALL_APPICON_ASSETS = YES

// MARK: - Localization

CLANG_ANALYZER_LOCALIZABILITY_NONLOCALIZED = YES
